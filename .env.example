POSTGRES_DB=datamind
POSTGRES_USER=datamind
POSTGRES_PASSWORD=datamind
DATABASE_URL=postgresql+asyncpg://datamind:datamind@db:5432/datamind
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=datamind-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NextAuth & Auth.js URL
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-different-32-character-secret
INTERNAL_AUTH_SECRET=replace-with-a-third-32-character-secret

# OAuth: Google (Redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth: GitHub (Authorization callback URL: http://localhost:3000/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DataMind AI <no-reply@datamind.local>
SMTP_USE_TLS=true

